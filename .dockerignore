# Keep the build context to the ~1MB the image actually needs
# (without this, .venv alone ships ~213MB to the docker daemon per build).
.venv
.git
.pytest_cache
.mypy_cache
.ruff_cache
__pycache__
*.pyc
.coverage
docs
tests
scratch
# examples/ is NOT excluded: the compose stack's enterprise-backend service runs
# examples/enterprise_scenario/serve.py as the governed downstream system.
examples/**/__pycache__
*.md
!README.md
