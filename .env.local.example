# Copy to .env.local (already gitignored — never commit the copy):
#   cp .env.local.example .env.local
# Then load it before make/docker-compose/poetry commands:
#   set -a; source .env.local; set +a
#
# docker-compose.yml reads these same names via ${VAR:-default}, so sourcing
# this file before `docker compose ...` / `make up` / `make up-demo` picks
# them up automatically — no separate compose env file needed.

# ---- make up-demo / examples.langgraph_governed_agent -----------------
# See examples/langgraph_governed_agent/README.md, "Run it" and
# "Watch it on the dashboard" for which of these apply to which step.

# (a) simplest identity path: matches docker-compose.yml's own gateway
# default (OAC_IDENTITY_MODE=header). Leave unset to instead exercise the
# real OAuth path below.
OAC_USE_HEADER_IDENTITY=1

# (b) real OAuth path instead of (a) — only needed if OAC_USE_HEADER_IDENTITY
# is unset. Requires recreating the gateway container with these three set:
#   docker compose --profile demo up -d --no-deps gateway
#OAC_IDENTITY_MODE=oidc-jwks
#OAC_OIDC_DISCOVERY_URL=http://enterprise-backend:8090/.well-known/openid-configuration
#OAC_OIDC_AUDIENCE=api://openagent-control-gateway

# Override the demo's default addresses (http://localhost:8000 / :8090) only
# if you're not running the standard compose ports.
#OAC_GATEWAY_URL=
#OAC_TOKEN_URL=

# ---- live model instead of the deterministic scripted one --------------
# Required only to run the LangGraph examples against a real LLM. Unset or
# empty, the examples stay fully offline with zero API keys.
ANTHROPIC_API_KEY=

# anthropic:claude-sonnet-4-6, or any other init_chat_model-supported provider
# string. Read by demo.py directly (OAC_SCENARIO_MODEL for enterprise_scenario
# instead, same idea).
OAC_DEMO_MODEL=anthropic:claude-sonnet-4-6

# ---- make up-persistent / the control-plane dashboard -------------------
# Only needed once you bring up --profile persistence to see receipts on the
# dashboard (localhost:8001) instead of only the gateway's stdout log.
#
# NOTE the hostname differs by who's connecting: containers (gateway,
# control-plane) resolve "postgres" on the compose network, as set here — but
# a command you run yourself on the host (e.g. `openagent-control migrate`)
# needs "localhost" instead, since it's not on that network:
#   OAC_DATABASE_URL="postgresql+asyncpg://oac:oac@localhost:5432/oac" \
#     poetry run openagent-control migrate
OAC_DATABASE_URL=postgresql+asyncpg://oac:oac@postgres:5432/oac
OAC_REDIS_URL=redis://redis:6379/0

# Local dev secret for the control-plane dashboard's own auth — not a real
# credential from any external provider. Generate your own:
#   openssl rand -hex 24
OAC_CONTROL_PLANE_API_KEY=
OAC_CONTROL_PLANE_OPERATOR_AUTH_MODE=api-key
